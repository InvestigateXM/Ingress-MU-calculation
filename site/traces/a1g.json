3,2.412634559672906]]],["mb:15","l",[[2.5,2.5],[2.75,2.75]]],["ah2:15","p",[[2.6792893218813454,2.6792893218813454],[2.548474567361834,2.626256313292354],[2.626256313292354,2.548474567361834]]],["vl:15","t",[2.9,2.75,"start"],"0"],["bd:0:0","t",[0.5,0.1],"×1"],["ct:0:0","t",[0.5,0.91],"0"],["bd:1:0","t",[1.5,0.1],"×2"],["ct:1:0","t",[1.5,0.91],"100"],["bd:2:0","t",[2.5,0.1],"×1"],["ct:2:0","t",[2.5,0.91],"400"],["bd:0:1","t",[0.5,1.1],"×2"],["ct:0:1","t",[0.5,1.9100000000000001],"100"],["bd:1:1","t",[1.5,1.1],"×4"],["ct:1:1","t",[1.5,1.9100000000000001],"1,000"],["bd:2:1","t",[2.5,1.1],"×2"],["ct:2:1","t",[2.5,1.9100000000000001],"400"],["bd:0:2","t",[0.5,2.1],"×1"],["ct:0:2","t",[0.5,2.91],"0"],["bd:1:2","t",[1.5,2.1],"×2"],["ct:1:2","t",[1.5,2.91],"400"],["bd:2:2","t",[2.5,2.1],"×1"],["ct:2:2","t",[2.5,2.91],"0"]],"groups":{"px":["px:0:0","px:1:0","px:2:0","px:3:0","px:0:1","px:1:1","px:2:1","px:3:1","px:0:2","px:1:2","px:2:2","px:3:2","px:0:3","px:1:3","px:2:3","px:3:3"],"d":["d:0","d:1","d:2","d:3","d:4","d:5","d:6","d:7","d:8","d:9","d:10","d:11","d:12","d:13","d:14","d:15"],"sh":["sh:0","sh:1","sh:2","sh:3","sh:4","sh:5","sh:6","sh:7","sh:8","sh:9","sh:10","sh:11","sh:12","sh:13","sh:14","sh:15"],"mv":["mv:0","mv:1","mv:2","mv:3","mv:4","mv:5","mv:6","mv:7","mv:8","mv:9","mv:10","mv:11","mv:12","mv:13","mv:14","mv:15"],"ln":["ln:0","ln:1","ln:2","ln:3","ln:4","ln:5","ln:6","ln:7","ln:8","ln:9","ln:10","ln:11","ln:12","ln:13","ln:14","ln:15"],"ah":["ah:0","ah:1","ah:2","ah:3","ah:4","ah:5","ah:6","ah:7","ah:8","ah:9","ah:10","ah:11","ah:12","ah:13","ah:14","ah:15"],"mb":["mb:0","mb:1","mb:2","mb:3","mb:4","mb:5","mb:6","mb:7","mb:8","mb:9","mb:10","mb:11","mb:12","mb:13","mb:14","mb:15"],"ah2":["ah2:0","ah2:1","ah2:2","ah2:3","ah2:4","ah2:5","ah2:6","ah2:7","ah2:8","ah2:9","ah2:10","ah2:11","ah2:12","ah2:13","ah2:14","ah2:15"],"vl":["vl:0","vl:1","vl:2","vl:3","vl:4","vl:5","vl:6","vl:7","vl:8","vl:9","vl:10","vl:11","vl:12","vl:13","vl:14","vl:15"],"bd":["bd:0:0","bd:1:0","bd:2:0","bd:0:1","bd:1:1","bd:2:1","bd:0:2","bd:1:2","bd:2:2"],"ct":["ct:0:0","ct:1:0","ct:2:0","ct:0:1","ct:1:1","ct:2:1","ct:0:2","ct:1:2","ct:2:2"]},"tables":{},"steps":[{"c":"This made-up cell (orange) lies exactly over four pixels of the population map. The map stores one count of people for each pixel, and the game wants one density for the cell, in MU per km².","s":{"@px":"grid","cell":"hl"}},{"c":"The game places 16 measuring points in the cell, evenly spaced in 4 rows of 4.","s":{"@d":"dot"}},{"c":"Before reading the map, the game moves every point half a pixel up and to the left (the arrows). The game does not read the pixel a point lies in. It looks half a pixel up and to the left and reads the pixel it finds there.","s":{"@d":"ghost","@sh":"shift","@mv":"move","@ah":"ah"}},{"c":"Each shifted point reads the pixel it now lies in. Nine pixels are read, and a pixel read by several points counts several times (the ×2 and ×4 badges). The pixels that count can lie partly or even completely outside the cell: here 5 of the 9 lie completely outside, and they still count.","s":{"@d":"","@mv":"","@ah":"","@ln":"ptr","px:0:0":"read","px:1:0":"read","px:2:0":"read","px:0:1":"read","px:1:1":"read","px:2:1":"read","px:0:2":"read","px:1:2":"read","px:2:2":"read","bd:0:0":"b","bd:1:0":"b","bd:2:0":"b","bd:0:1":"b","bd:1:1":"b","bd:2:1":"b","bd:0:2":"b","bd:1:2":"b","bd:2:2":"b"}},{"c":"These are the counts of the nine pixels (made-up numbers).","s":{"ct:0:0":"m","ct:1:0":"m","ct:2:0":"m","ct:0:1":"m","ct:1:1":"m","ct:2:1":"m","ct:0:2":"m","ct:1:2":"m","ct:2:2":"m"}},{"c":"Now the numbers go back. Each point takes the count of the pixel it read (purple arrows) and keeps it at its original place in the cell. The shift was only where the game looked: the 16 numbers belong to the 16 points inside the cell.","s":{"@sh":"","@ln":"","@px":"grid","@bd":"","@ct":"","@d":"dot","@mb":"move2","@ah2":"ah2","cell":"hl","px:0:0":"read","px:1:0":"read","px:2:0":"read","px:0:1":"read","px:1:1":"read","px:2:1":"read","px:0:2":"read","px:1:2":"read","px:2:2":"read","vl:0":"t","vl:1":"t","vl:2":"t","vl:3":"t","vl:4":"t","vl:5":"t","vl:6":"t","vl:7":"t","vl:8":"t","vl:9":"t","vl:10":"t","vl:11":"t","vl:12":"t","vl:13":"t","vl:14":"t","vl:15":"t"}},{"c":"The density of the cell is the mean of these 16 numbers. Pixels with a count of 0 add nothing. So every spot in this cell counts as 400 MU per km², whatever is actually inside it.","s":{"@mb":"","@ah2":"","@vl":"b"},"eq":"(2×100 + 1×400 + 2×100 + 4×1,000 + 2×400 + 2×400) / 16 = 6,400 / 16 = 400 MU per km²"}],"schematic":true}
